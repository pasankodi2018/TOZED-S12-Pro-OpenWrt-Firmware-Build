#!/bin/sh /etc/rc.common
# /etc/init.d/modem_led
# Self-contained Signal LED monitor
START=95
STOP=10
USE_PROCD=1

DEVICE="/dev/ttyUSB0"
LED_PREFIX="blue:signal"
UPDATE_INTERVAL=10
LOG_TAG="Modem LED"

start_service() {
    procd_open_instance
    procd_set_param respawn

    procd_set_param command /bin/sh -c "
sleep 30

DEVICE='${DEVICE}'
LED_PREFIX='${LED_PREFIX}'
UPDATE_INTERVAL=${UPDATE_INTERVAL}
LOG_TAG='${LOG_TAG}'

current_level=0

get_rsrp() {
    DATA=\$(sms_tool -D -d \"\$DEVICE\" at 'AT+ZRSSI?' 2>/dev/null)
    ZRSSI_LINE=\$(echo \"\$DATA\" | grep '+ZRSSI:')
    RSRP=\$(echo \"\$ZRSSI_LINE\" | awk '{print \$2}' | cut -d',' -f1)
    [ -z \"\$RSRP\" ] && RSRP=-140
    echo \"\$RSRP\"
}

set_leds() {
    level=\$1
    for i in \$(seq 1 5); do
        LED_PATH=\"/sys/class/leds/\${LED_PREFIX}\${i}/brightness\"
        if [ \"\$i\" -le \"\$level\" ]; then
            echo 1 > \"\$LED_PATH\"
        else
            echo 0 > \"\$LED_PATH\"
        fi
    done
}

logger -t \"\$LOG_TAG\" 'Signal LED monitor started.'

while [ ! -e \"\$DEVICE\" ]; do
    logger -t \"\$LOG_TAG\" \"\$DEVICE not found, waiting...\"
    sleep 2
done

while true; do
    rsrp=\$(get_rsrp)

    if [ \"\$rsrp\" -eq -140 ]; then
        # no valid reading, skip updating LEDs
        sleep \"\$UPDATE_INTERVAL\"
        continue
    fi

    if [ \"\$rsrp\" -ge -60 ]; then
        level=5
    elif [ \"\$rsrp\" -ge -70 ]; then
        level=4
    elif [ \"\$rsrp\" -ge -80 ]; then
        level=3
    elif [ \"\$rsrp\" -ge -90 ]; then
        level=2
    elif [ \"\$rsrp\" -ge -100 ]; then
        level=1
    else
        level=0
    fi

    if [ \"\$level\" -ne \"\$current_level\" ]; then
        set_leds \"\$level\"
        current_level=\"\$level\"
        logger -t \"\$LOG_TAG\" \"RSRP=\$rsrp -> LED level=\$level\"
    fi

    sleep \"\$UPDATE_INTERVAL\"
done
"
    procd_close_instance
}

stop_service() {
    logger -t "$LOG_TAG" "Stopping service..."
    killall -q sms_tool
    for i in $(seq 1 5); do
        echo 0 > "/sys/class/leds/${LED_PREFIX}${i}/brightness"
    done
}
