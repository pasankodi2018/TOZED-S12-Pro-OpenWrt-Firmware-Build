_DEVICE=/dev/ttyUSB0
_DEFAULT_LTE_BANDS="1 3 5 7 8 38 39 40 41"

getsupportedbands() {
	echo "$_DEFAULT_LTE_BANDS"
}

getinfo() {
	echo "TOZED LT70 Spreadtrum Communication CO."
}

setbands() {
    BANDS="$1"

    tdd49_64=0
    tdd33_48=0
    fdd17_32=0
    fdd1_16=0
    fdd65_80=0

    for band in $BANDS; do
        case $band in
            # FDD 1–16
            [1-9]|1[0-6])
                fdd1_16=$((fdd1_16 | (1 << (band-1))))
                ;;
            # FDD 17–32
            1[7-9]|2[0-9]|3[0-2])
                fdd17_32=$((fdd17_32 | (1 << (band-17))))
                ;;
            # TDD 33–48
            3[3-9]|4[0-8])
                tdd33_48=$((tdd33_48 | (1 << (band-33))))
                ;;
            # TDD 49–64
            4[9-9]|5[0-9]|6[0-4])
                tdd49_64=$((tdd49_64 | (1 << (band-49))))
                ;;
            # FDD 65–80
            6[5-9]|7[0-9]|80)
                fdd65_80=$((fdd65_80 | (1 << (band-65))))
                ;;
        esac
    done

    sms_tool -D -d "$_DEVICE" at "AT+SPLBAND=1,$tdd49_64,$tdd33_48,$fdd17_32,$fdd1_16,$fdd65_80"
    sms_tool -D -d "$_DEVICE" at 'AT+CFUN=0'
    sms_tool -D -d "$_DEVICE" at 'AT+CFUN=1'
}

getbands() {
    RAW=$(sms_tool -D -d "$_DEVICE" at 'AT+SPLBAND=0' 2>/dev/null | grep '+SPLBAND:')
    VALS=$(echo "$RAW" | tr -d '\r\n ' | sed 's/^+SPLBAND://')
    [ -z "$VALS" ] && return

    tdd33_48=$(echo "$VALS" | cut -d',' -f2)
    fdd1_16=$(echo "$VALS" | cut -d',' -f4)

    RES=""

    # Decode FDD 1-16 (Bands 1, 3, 5, 7, 8)
    if [ -n "$fdd1_16" ] && [ "$fdd1_16" -gt 0 ] 2>/dev/null; then
        for b in 1 3 5 7 8; do
            if [ $(( (fdd1_16 >> (b - 1)) & 1 )) -eq 1 ]; then
                RES="${RES:+$RES }$b"
            fi
        done
    fi

    # Decode TDD 33-48 (Bands 38, 39, 40, 41)
    if [ -n "$tdd33_48" ] && [ "$tdd33_48" -gt 0 ] 2>/dev/null; then
        for b in 38 39 40 41; do
            if [ $(( (tdd33_48 >> (b - 33)) & 1 )) -eq 1 ]; then
                RES="${RES:+$RES }$b"
            fi
        done
        # Fallback check for B41 (vendor firmware value 64 / 192)
        if [ "$tdd33_48" -eq 64 ] || [ "$tdd33_48" -eq 192 ]; then
            case " $RES " in
                *" 41 "*) ;;
                *) RES="${RES:+$RES }41" ;;
            esac
        fi
    fi

    echo "$RES"
}
